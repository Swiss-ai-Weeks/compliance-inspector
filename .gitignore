# COMPLIANCE INSPECTOR — .gitignore
# Covers: Python, AI/NIM artifacts, macOS, Linux, Windows environments


# Project specific / Model output files (can be regenerated by running the pipeline):
output/
*.json
!data/sops/*.json
!data/mocks/*.json

# Cached NIM model weights (can be huge — GBs):
nim-cache/
~/nim-cache/
.cache/

# Extracted video frames (intermediate files)
output/frames.json

# Environment and secrets:
.env
.env.*
*.env
secrets.yaml
secrets.json
ngc_api_key.txt

# Python stuff:
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments:
venv/
.venv/
env/
.env/
ENV/

# Distribution / build:
build/
dist/
*.egg-info/
*.egg
.eggs/

# Testing & coverage:
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Jupyter notebooks checkpoints:
.ipynb_checkpoints/

# Type checking:
.mypy_cache/
.dmypy.json

# Environment for Windows, Linux, macOS:
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
*~
.nfs*
Thumbs.db
Thumbs.db:encdata
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Editors / IDs
# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm etc.)
.idea/
*.iml

# Vim/Neovim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# Browser-based temporary files and cache
.chrome_tmp/
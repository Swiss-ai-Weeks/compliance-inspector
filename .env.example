# Visual Compliance Inspector — environment configuration
#
# Copy to .env and fill in. NOTE: neither app.py nor src/nim_client.py calls
# load_dotenv(), so a .env file is NOT read automatically. Export the values
# into the shell that launches Streamlit:
#
#     set -a; source .env; set +a
#     streamlit run app.py
#
# python-dotenv is in requirements.txt but currently unused by the app.

# Base URL of the OpenAI-compatible NIM endpoint.
# Self-hosted NIM (see docs/brev-nim-deployment.md):
NIM_BASE_URL=http://localhost:8000/v1
# Hosted NVIDIA API alternative:
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model id. MUST include the `nvidia/` org prefix — the built-in default in
# src/nim_client.py ("cosmos3-nano-reasoner") omits it and will 404 against a
# self-hosted NIM, so always set this explicitly.
NIM_MODEL=nvidia/cosmos3-nano-reasoner

# A self-hosted NIM does not authenticate requests, but the OpenAI SDK
# requires a non-empty string. Use a real NVIDIA API key only when pointing
# NIM_BASE_URL at integrate.api.nvidia.com.
NIM_API_KEY=not-needed

# NGC Personal API Key with Catalog access — used to `docker login nvcr.io`
# and to let the NIM container download model weights. Never commit the real
# value; .env is gitignored.
NGC_API_KEY=
